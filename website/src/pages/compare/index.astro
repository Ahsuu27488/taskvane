---
import Page from '../../layouts/Page.astro';
import { COMPARISONS } from '../../lib/compare';
---
<Page
  title="Compare Taskvane with Task Manager, HWiNFO and LibreHardwareMonitor"
  h1="How Taskvane compares"
  lede="Honest side-by-sides with the tools you might already use, including where each one is the better choice."
  description="Compare Taskvane with Windows Task Manager, HWiNFO and LibreHardwareMonitor: temperatures, power draw, process management, alerts and licensing."
  crumbs={[{ name: 'Compare', path: '/compare/' }]}
>
  <ul class="list">
    {COMPARISONS.map((c) => (
      <li>
        <h2><a href={`/compare/${c.slug}/`}>Taskvane vs {c.other}</a></h2>
        <p>{c.verdict}</p>
      </li>
    ))}
  </ul>
</Page>

<style>
  .list { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--rule); }
  .list li { padding: 28px 0; border-bottom: 1px solid var(--rule); }
  .list h2 { font-size: 32px; margin: 0 0 10px; }
  .list h2 a { color: var(--ink); text-decoration: none; }
  .list h2 a:hover { color: var(--blue); }
  .list p { color: var(--slate); margin: 0; }
</style>
