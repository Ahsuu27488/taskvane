---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Taskvane" description="This page doesn't exist. Go to the Taskvane home page or download the app.">
  <section class="wrap nf">
    <h1>This page doesn't exist</h1>
    <p class="lede">The link may be old or mistyped. Try one of these instead.</p>
    <p class="go"><a class="btn btn-primary" href="/">Taskvane home</a> <a class="btn btn-quiet" href="/download/">Download</a> <a class="btn btn-quiet" href="/faq/">FAQ</a></p>
  </section>
</Base>

<style>
  .nf { padding-top: 96px; }
  .nf h1 { margin-bottom: 20px; }
  .go { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
</style>
