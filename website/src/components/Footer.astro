---
import { SITE, APP_VERSION } from '../lib/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap cols">
    <div class="who">
      <p class="made">Made by <a href="/about/">{SITE.author.name}</a> in {SITE.author.location}.</p>
      <p>Taskvane is free software under the <a href={`${SITE.repo}/blob/main/LICENSE`}>GNU GPL v3</a>. Version {APP_VERSION}.</p>
    </div>
    <nav aria-label="Footer">
      <ul>
        <li><a href="/download/">Download</a></li>
        <li><a href="/features/">Features</a></li>
        <li><a href="/changelog/">Changelog</a></li>
        <li><a href="/docs/">Docs</a></li>
      </ul>
      <ul>
        <li><a href="/compare/task-manager/">vs Task Manager</a></li>
        <li><a href="/compare/hwinfo/">vs HWiNFO</a></li>
        <li><a href="/compare/librehardwaremonitor/">vs LibreHardware&shy;Monitor</a></li>
        <li><a href="/faq/">FAQ</a></li>
      </ul>
      <ul>
        <li><a href={SITE.repo}>Source code</a></li>
        <li><a href={`${SITE.repo}/issues/new/choose`}>Report a problem</a></li>
        <li><a href={`${SITE.repo}/blob/main/SECURITY.md`}>Security</a></li>
        <li><a href="/llms.txt">For AI assistants</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap fine">© {year} {SITE.author.name}. Windows and Task Manager are trademarks of Microsoft; Taskvane is not affiliated with Microsoft.</div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--rule); margin-top: 96px; padding: 48px 0 32px; background: var(--paper); font-size: 15px; color: var(--slate); }
  .cols { display: grid; grid-template-columns: 1.2fr 2fr; gap: 40px; }
  .made { color: var(--ink); font-size: 17px; }
  nav { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  a { color: var(--slate); }
  a:hover { color: var(--ink); }
  .fine { margin-top: 36px; font-size: 13px; color: #74849a; }
  @media (max-width: 760px) { .cols { grid-template-columns: 1fr; } nav { grid-template-columns: 1fr 1fr; } }
</style>
