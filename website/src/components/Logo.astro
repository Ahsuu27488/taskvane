---
// The app icon: blue tile with a pulse line (same artwork as assets/icon.ico)
interface Props { size?: number }
const { size = 28 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
  <rect x="1" y="1" width="22" height="22" rx="6" fill="#3987e5" />
  <path d="M5 13h3l2-5 3 9 2-6 1.5 2H19" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
</svg>
