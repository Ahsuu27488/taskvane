---
import Logo from './Logo.astro';
import { SITE } from '../lib/site';
const path = Astro.url.pathname;
const nav = [
  { href: '/features/', label: 'Features' },
  { href: '/compare/', label: 'Compare' },
  { href: '/guides/', label: 'Guides' },
  { href: '/docs/', label: 'Docs' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/about/', label: 'About' },
];
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="Taskvane home"><Logo /><span>Taskvane</span></a>
    <nav id="site-nav" aria-label="Main">
      <ul>
        {nav.map((n) => (
          <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
        <li class="gh"><a href={SITE.repo} rel="noopener">GitHub</a></li>
      </ul>
    </nav>
    <a class="btn btn-primary dl" href="/download/">Download</a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path class="l1" d="M4 7h16"/><path class="l2" d="M4 12h16"/><path class="l3" d="M4 17h16"/></svg>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header') as HTMLElement;
  const btn = header.querySelector('.menu-btn') as HTMLButtonElement;
  const set = (open: boolean) => { header.dataset.open = String(open); btn.setAttribute('aria-expanded', String(open)); };
  btn.addEventListener('click', () => set(header.dataset.open !== 'true'));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && header.dataset.open === 'true') { set(false); btn.focus(); } });
  document.addEventListener('click', (e) => { if (!header.contains(e.target as Node)) set(false); });
</script>

<style>
  .site-header { border-bottom: 1px solid var(--rule); background: color-mix(in srgb, var(--fog) 88%, transparent); backdrop-filter: blur(8px); position: sticky; top: 0; z-index: 5; }
  .bar { display: flex; align-items: center; gap: 28px; height: 68px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); font-weight: 700; font-size: 20px; font-stretch: 85%; }
  nav { flex: 1; }
  ul { list-style: none; display: flex; gap: 22px; margin: 0; padding: 0; }
  nav a { color: var(--slate); text-decoration: none; font-weight: 500; font-size: 16px; padding: 6px 0; }
  nav a:hover { color: var(--ink); }
  nav a[aria-current='page'] { color: var(--ink); box-shadow: inset 0 -2px 0 var(--blue); }
  .dl { padding: 10px 18px; font-size: 16px; }
  .menu-btn { display: none; }
  @media (max-width: 820px) {
    .bar { height: 60px; gap: 12px; }
    .brand { flex: 1; font-size: 19px; }
    .dl { padding: 9px 16px; font-size: 15px; }
    .menu-btn { display: grid; place-items: center; width: 42px; height: 42px; margin-right: -6px; border: 0; border-radius: 10px; background: transparent; color: var(--ink); cursor: pointer; }
    .menu-btn:hover { background: color-mix(in srgb, var(--ink) 7%, transparent); }
    .menu-btn svg { width: 24px; height: 24px; }
    .menu-btn path { transition: transform .2s, opacity .2s; transform-origin: 12px 12px; }
    .site-header[data-open='true'] .l1 { transform: translateY(5px) rotate(45deg); }
    .site-header[data-open='true'] .l2 { opacity: 0; }
    .site-header[data-open='true'] .l3 { transform: translateY(-5px) rotate(-45deg); }
    nav { display: none; position: absolute; left: 0; right: 0; top: 100%; background: var(--paper); border-bottom: 1px solid var(--rule); box-shadow: 0 18px 30px -18px rgba(21, 34, 50, .35); }
    .site-header[data-open='true'] nav { display: block; }
    ul { flex-direction: column; gap: 0; padding: 6px var(--gutter) 14px; }
    nav a { display: block; padding: 13px 2px; font-size: 18px; color: var(--ink); border-bottom: 1px solid var(--rule); }
    li:last-child a { border-bottom: 0; }
    nav a[aria-current='page'] { box-shadow: inset 3px 0 0 var(--blue); padding-left: 14px; }
  }
</style>
